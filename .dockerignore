# Docker ignore file for TradePulse.AI
# Optimize Docker build by excluding unnecessary files

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
dist/
build/
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Logs
logs/*.log
*.log

# Data
data/database/dynamodb/*
data/ml/drift_monitoring/*
data/reports/*
data/dashboard_backup/*

# Node (frontend)
node_modules/
app/frontend/node_modules/
app/frontend/dist/
app/frontend/.astro/

# Infrastructure
infra/terraform.tfstate*
infra/tfplan
infra/.terraform/
*.tfvars
!*.tfvars.example

# Monitoring
monitoring/

# Documentation
docs/
*.md
!README.md

# Scripts (not needed in container)
scripts/
start_*.sh

# Config files (use env vars in container)
*.csv
KrisRz_accessKeys.csv
Kris_accessKeys.csv

# Misc
.env.local
.env.*.local
*.bak
*.tmp