# TradePulse.AI Docker Environment Configuration
# Copy this file to .env and set your actual values

# Binance API Keys (Required for live trading)
# Copy this file to .env and set your actual values
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Binance Demo Trading — used by BinanceDemoExecutor and scripts/demo_roundtrip.py
# Minted at demo.binance.com -> Account -> API Management (NOT the same account,
# and NOT the same keys, as the Spot Testnet at testnet.binance.vision).
# Needs "Enable Reading" + "Enable Spot & Margin Trading". Fake money only.
BINANCE_DEMO_KEY=your_demo_api_key_here
BINANCE_DEMO_SECRET=your_demo_secret_key_here

# Database Configuration (DynamoDB Local)
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Application Configuration
ENVIRONMENT=docker
DEBUG=false
SECRET_KEY=tradepulse-docker-secret-change-in-production
API_HOST=0.0.0.0
API_PORT=9002

# Trading Configuration  
PROFESSIONAL_MODE=true
DAY_TRADING_MODE=true
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
