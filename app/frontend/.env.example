# TradePulse.AI Frontend Environment Configuration
# Copy this file to .env for local development

# API Configuration
PUBLIC_API_URL=http://localhost:9001
PUBLIC_API_TIMEOUT=30000

# Application Configuration
PUBLIC_APP_NAME=TradePulse.AI
PUBLIC_APP_VERSION=1.0.0
PUBLIC_REFRESH_INTERVAL=30000

# Feature Flags
PUBLIC_ENABLE_PWA=true
PUBLIC_ENABLE_ANALYTICS=true
PUBLIC_ENABLE_DARK_MODE=true

# Development Settings
DEV_ENABLE_LOGGING=true
DEV_ENABLE_STORYBOOK=true

# Security
# Note: These should be set in production environment
# PUBLIC_SENTRY_DSN=
# PUBLIC_ANALYTICS_ID=