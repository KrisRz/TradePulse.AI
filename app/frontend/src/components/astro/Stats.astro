---
// Stats section component - AI vs Random performance
---

<section class="py-16 bg-white dark:bg-dark-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        AI vs Random Trading
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        See the difference our AI makes. All data is transparent and verifiable.
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- AI Performance -->
      <div class="bg-gradient-to-r from-profit-50 to-primary-50 dark:from-profit-900/20 dark:to-primary-900/20 p-8 rounded-xl">
        <div class="flex items-center mb-6">
          <div class="w-12 h-12 bg-profit-500 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">TradePulse AI</h3>
            <p class="text-profit-600 dark:text-profit-400 font-medium">Advanced ML System</p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-6">
          <div>
            <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">68.3%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Win Rate</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">+24.7%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Monthly ROI</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">1.84</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Sharpe Ratio</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">-4.2%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Max Drawdown</div>
          </div>
        </div>
        
        <div class="mt-6 p-4 bg-profit-100 dark:bg-profit-900/30 rounded-lg">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-profit-600 dark:text-profit-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span class="text-sm text-profit-700 dark:text-profit-300 font-medium">
              67 consecutive profitable days
            </span>
          </div>
        </div>
      </div>
      
      <!-- Random Trading Performance -->
      <div class="bg-gradient-to-r from-loss-50 to-gray-50 dark:from-loss-900/20 dark:to-gray-900/20 p-8 rounded-xl">
        <div class="flex items-center mb-6">
          <div class="w-12 h-12 bg-loss-500 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Random Trading</h3>
            <p class="text-loss-600 dark:text-loss-400 font-medium">No Strategy</p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-6">
          <div>
            <div class="text-3xl font-bold text-loss-600 dark:text-loss-400">45.7%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Win Rate</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-loss-600 dark:text-loss-400">-8.3%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Monthly ROI</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-loss-600 dark:text-loss-400">-0.47</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Sharpe Ratio</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-loss-600 dark:text-loss-400">-18.9%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Max Drawdown</div>
          </div>
        </div>
        
        <div class="mt-6 p-4 bg-loss-100 dark:bg-loss-900/30 rounded-lg">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-loss-600 dark:text-loss-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" />
            </svg>
            <span class="text-sm text-loss-700 dark:text-loss-300 font-medium">
              Consistent losses over time
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Comparison Highlights -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="text-center p-6 bg-gray-50 dark:bg-dark-800 rounded-lg">
        <div class="text-4xl font-bold text-profit-600 dark:text-profit-400 mb-2">+22.6%</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Better Win Rate</div>
        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">68.3% vs 45.7%</div>
      </div>
      
      <div class="text-center p-6 bg-gray-50 dark:bg-dark-800 rounded-lg">
        <div class="text-4xl font-bold text-profit-600 dark:text-profit-400 mb-2">+33%</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Monthly ROI Advantage</div>
        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">+24.7% vs -8.3%</div>
      </div>
      
      <div class="text-center p-6 bg-gray-50 dark:bg-dark-800 rounded-lg">
        <div class="text-4xl font-bold text-profit-600 dark:text-profit-400 mb-2">78%</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">Less Risk</div>
        <div class="text-xs text-gray-500 dark:text-gray-500 mt-1">-4.2% vs -18.9% drawdown</div>
      </div>
    </div>
    
    <!-- Disclaimer -->
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        * Performance data based on 12-month backtesting and 90-day live virtual trading. Past performance does not guarantee future results. 
        All trading involves risk and users should start with virtual portfolios.
      </p>
    </div>
  </div>
</section> 