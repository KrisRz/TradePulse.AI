---
// Hero — "London ledger" direction. Opens with the live system itself:
// a ledger strip fed by the real bot status endpoint, then the thesis.
const STATUS_URL = "https://xwibtclmvzlqtz2xtgrnm7l3tm0hzqbs.lambda-url.eu-west-2.on.aws/?format=json";
const BOT_URL = "https://xwibtclmvzlqtz2xtgrnm7l3tm0hzqbs.lambda-url.eu-west-2.on.aws/";
---

<section class="ledger-hero" data-status-url={STATUS_URL}>
  <!-- Signature: live ledger strip -->
  <div class="ledger-strip" id="ledger-strip" aria-live="polite">
    <span class="dot" aria-hidden="true"></span>
    <span class="mono" id="ledger-text">PAPER TRADING · BTCUSDT 1d · EMA 20/100 · live since 16 Jul 2026</span>
  </div>

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">A systematic Bitcoin strategy, run in public</p>
      <h1>Evidence<br />before money.</h1>
      <p class="lede">
        TradePulse trades one validated strategy on daily Bitcoin bars —
        backtest and live share the same code, every decision is recorded,
        and not a pound is at risk while the system earns its proof.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href="/auth/register">Create a free account</a>
        <a class="btn-ghost" href={BOT_URL} rel="noopener">Watch the live bot →</a>
      </div>
    </div>

    <aside class="factsheet" aria-label="Strategy factsheet">
      <h2 class="fs-title mono">STRATEGY FACTSHEET</h2>
      <dl>
        <div><dt>Strategy</dt><dd>EMA 20/100 crossover, long only</dd></div>
        <div><dt>Market</dt><dd>BTC/USDT, daily bars</dd></div>
        <div><dt>Sharpe, out-of-sample</dt><dd><strong class="good">1.11</strong> vs 0.87 buy &amp; hold</dd></div>
        <div><dt>Max drawdown</dt><dd><strong class="good">−49%</strong> vs −77% buy &amp; hold</dd></div>
        <div><dt>Validation</dt><dd>Walk-forward, 2017–2026</dd></div>
        <div><dt>Costs modelled</dt><dd>0.1% fee + slippage, per side</dd></div>
        <div><dt>Status</dt><dd>Paper trading, live since 16 Jul 2026</dd></div>
      </dl>
      <p class="fs-note">Simulated and live results alike do not guarantee future performance.</p>
    </aside>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.getElementById("ledger-text");
    var section = document.querySelector(".ledger-hero");
    if (!el || !section) return;
    fetch(section.dataset.statusUrl)
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var pos = { "1": "LONG", "0": "FLAT", "-1": "SHORT" }[String(Math.round(d.position))] || "—";
        var bar = (d.last_bar || "").slice(0, 10);
        el.textContent =
          "LIVE · " + d.symbol + " 1d · " + (d.strategy || "EMA 20/100") +
          " · position " + pos +
          " · equity $" + Number(d.equity).toLocaleString("en-GB") +
          " · last bar " + bar + " · next run 00:10 UTC";
      })
      .catch(function () { /* keep the static line */ });
  })();
</script>

<style>
  .ledger-hero {
    --paper: #f6f5f1;
    --ink: #101d2c;
    --sterling: #0e6e4c;
    --grey: #5c6875;
    --rule: #d9dcd4;
    background: var(--paper);
    color: var(--ink);
    font-family: "Public Sans", system-ui, sans-serif;
  }

  .ledger-strip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.25rem;
    border-bottom: 1px solid var(--rule);
    background: #eeede7;
    overflow-x: auto;
    white-space: nowrap;
  }
  .mono {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sterling);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }

  .hero-grid {
    max-width: 72rem;
    margin: 0 auto;
    padding: 5rem 1.5rem 4.5rem;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; padding-top: 3.5rem; gap: 3rem; }
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sterling);
    margin: 0 0 1.4rem;
  }
  h1 {
    font-family: "Libre Caslon Text", Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    margin: 0 0 1.6rem;
  }
  .lede {
    font-size: 1.13rem;
    line-height: 1.65;
    color: var(--grey);
    max-width: 34rem;
    margin: 0 0 2.2rem;
  }

  .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    padding: 0.85rem 1.6rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.15s ease;
  }
  .btn-primary:hover { background: #1d3049; }
  .btn-primary:focus-visible,
  .btn-ghost:focus-visible { outline: 2px solid var(--sterling); outline-offset: 3px; }
  .btn-ghost {
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 2px solid var(--sterling);
    padding-bottom: 2px;
  }
  .btn-ghost:hover { color: var(--sterling); }

  .factsheet {
    border: 1px solid var(--ink);
    background: #fffef9;
    padding: 1.6rem 1.5rem 1.2rem;
    box-shadow: 6px 6px 0 0 var(--rule);
  }
  .fs-title {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--sterling);
    margin: 0 0 1rem;
    font-weight: 500;
  }
  dl { margin: 0; }
  dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
  }
  dl > div:last-of-type { border-bottom: 1px solid var(--ink); }
  dt { color: var(--grey); }
  dd { margin: 0; text-align: right; font-weight: 500; }
  .good { color: var(--sterling); }
  .fs-note {
    font-size: 0.75rem;
    color: var(--grey);
    margin: 0.9rem 0 0;
    font-style: italic;
  }
</style>
