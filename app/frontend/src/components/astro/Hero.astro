---
// Hero section component
---

<section class="relative bg-gradient-to-br from-primary-50 to-primary-100 dark:from-dark-900 dark:to-dark-800 py-20 lg:py-32 overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[url('/grid.svg')] bg-repeat"></div>
  </div>
  
  <!-- Floating particles -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-32 h-32 bg-primary-400 rounded-full opacity-20 animate-pulse-slow"></div>
    <div class="absolute top-1/3 right-1/3 w-24 h-24 bg-primary-500 rounded-full opacity-30 animate-bounce-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-20 h-20 bg-primary-600 rounded-full opacity-20 animate-ping-slow"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium mb-6">
        <span class="w-2 h-2 bg-profit-500 rounded-full mr-2 animate-pulse"></span>
        Paper Trading Live Since July 2026 • Walk-Forward Validated
      </div>
      
      <!-- Main headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
        <span class="block">Algorithmic Crypto Trading</span>
        <span class="block text-gradient-animate">With a Validated Edge</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
        Start with a $50,000 virtual portfolio and follow a strategy validated walk-forward,
        out-of-sample on 2017&ndash;2026 BTC data.
        <span class="text-primary-600 dark:text-primary-400 font-semibold">Paper trading &mdash; no real money at risk.</span>
      </p>
      
      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 max-w-2xl mx-auto">
        <div class="text-center">
          <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">1.11</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">OOS Sharpe (vs 0.87 buy &amp; hold)</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">&minus;49%</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Max Drawdown (vs &minus;77% buy &amp; hold)</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-warning-600 dark:text-warning-400">$50k</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Virtual Start</div>
        </div>
      </div>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a 
          href="/auth/signup" 
          class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-1 focus-ring"
        >
          Start Virtual Trading
        </a>
        <a 
          href="/auth/register" 
          class="bg-white dark:bg-dark-800 text-primary-600 dark:text-primary-400 px-8 py-4 rounded-lg font-semibold text-lg border border-primary-200 dark:border-primary-700 hover:bg-primary-50 dark:hover:bg-primary-900 transition-colors focus-ring"
        >
          Create Free Account
        </a>
      </div>
      
      <!-- Methodology note (real, verifiable claims only) -->
      <div class="flex items-center justify-center text-sm text-gray-600 dark:text-gray-400">
        <span>
          Strategy: EMA20/100 crossover, BTC 1d, long-only &middot; validated on a walk-forward,
          out-of-sample harness (fees + slippage included) &middot; paper trading live since 2026-07-16
        </span>
      </div>
    </div>
  </div>
  
  <!-- Dashboard Preview -->
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="gradient-border rounded-xl overflow-hidden shadow-2xl">
      <div class="bg-white dark:bg-dark-800 p-1">
        <div class="bg-gray-50 dark:bg-dark-900 rounded-lg p-6">
          <!-- Validated strategy metrics (walk-forward, out-of-sample; docs/M4_EDGE_VALIDATION.md) -->
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Validated Strategy Metrics</h3>
            <div class="flex items-center space-x-2">
              <div class="w-2 h-2 bg-profit-500 rounded-full"></div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Paper Trading Live</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <!-- OOS Sharpe -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Out-of-Sample Sharpe</div>
              <div class="text-2xl font-bold text-profit-600 dark:text-profit-400">1.11</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">vs 0.87 buy &amp; hold</div>
            </div>
            
            <!-- Max Drawdown -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Max Drawdown</div>
              <div class="text-2xl font-bold text-gray-900 dark:text-white">&minus;49%</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">vs &minus;77% buy &amp; hold</div>
            </div>
            
            <!-- Strategy -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Strategy</div>
              <div class="text-2xl font-bold text-primary-600 dark:text-primary-400">EMA 20/100</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">BTC 1d, long-only</div>
            </div>
            
            <!-- Validation window -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Validated Out-of-Sample</div>
              <div class="text-2xl font-bold text-gray-900 dark:text-white">2017&ndash;2026</div>
              <div class="text-sm text-warning-600 dark:text-warning-400">walk-forward folds</div>
            </div>
          </div>
          
          <!-- Chart placeholder -->
          <div class="mt-6 bg-white dark:bg-dark-800 p-4 rounded-lg">
            <div class="h-32 bg-gradient-to-r from-primary-100 to-profit-100 dark:from-primary-900 dark:to-profit-900 rounded-lg flex items-center justify-center">
              <div class="text-center">
                <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">Backtest window: 2017&ndash;2026 &middot; 36 out-of-sample trades &middot; fees &amp; slippage included</div>
                <div class="flex items-center justify-center space-x-2">
                  <div class="w-1 h-8 bg-primary-500 rounded animate-pulse"></div>
                  <div class="w-1 h-12 bg-profit-500 rounded animate-pulse" style="animation-delay: 0.2s"></div>
                  <div class="w-1 h-6 bg-primary-400 rounded animate-pulse" style="animation-delay: 0.4s"></div>
                  <div class="w-1 h-16 bg-profit-600 rounded animate-pulse" style="animation-delay: 0.6s"></div>
                  <div class="w-1 h-10 bg-primary-500 rounded animate-pulse" style="animation-delay: 0.8s"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient-animate {
    background: linear-gradient(-45deg, #3b82f6, #1d4ed8, #6366f1, #8b5cf6);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  .animate-pulse-slow {
    animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  .animate-bounce-slow {
    animation: bounce 2s infinite;
  }
  
  .animate-ping-slow {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style> 