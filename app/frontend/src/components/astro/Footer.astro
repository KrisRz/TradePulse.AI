---
// Footer — ledger style; only links that actually exist.
const currentYear = new Date().getFullYear();
const BOT_URL = "https://bot.tradepulseai.co.uk/";
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand">
        <span class="name">TradePulse</span>
        <p class="tagline">
          A systematic Bitcoin strategy, validated walk-forward and proven in
          live paper trading before any real money is considered.
        </p>
      </div>
      <nav aria-label="Footer">
        <p class="col-title mono">PLATFORM</p>
        <a href="/user_dashboard">Dashboard</a>
        <a href="/user_dashboard/portfolio">Portfolio</a>
        <a href={BOT_URL} rel="noopener">Live bot ledger</a>
      </nav>
      <nav aria-label="Account">
        <p class="col-title mono">ACCOUNT</p>
        <a href="/auth/register">Create account</a>
        <a href="/auth/login">Sign in</a>
      </nav>
    </div>
    <div class="legal">
      <p>© {currentYear} TradePulse. Personal research project — not financial advice, not FCA-regulated. Paper trading only.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #101d2c;
    color: #f6f5f1;
    font-family: "Public Sans", system-ui, sans-serif;
    border-top: 1px solid #1d3049;
  }
  .wrap { max-width: 72rem; margin: 0 auto; padding: 3rem 1.5rem 2rem; }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
  }
  @media (max-width: 700px) { .cols { grid-template-columns: 1fr; } }

  .name {
    font-family: "Libre Caslon Text", Georgia, serif;
    font-weight: 700;
    font-size: 1.25rem;
  }
  .tagline {
    color: #b9c2cc;
    font-size: 0.88rem;
    line-height: 1.6;
    max-width: 26rem;
    margin: 0.8rem 0 0;
  }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .col-title {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: #7d8b99;
    margin: 0 0 0.8rem;
    font-weight: 500;
  }
  nav a {
    display: block;
    color: #d5dbe1;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.25rem 0;
  }
  nav a:hover { color: #fff; text-decoration: underline; }
  nav a:focus-visible { outline: 2px solid #0e6e4c; outline-offset: 2px; }
  .legal {
    border-top: 1px solid #1d3049;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
  }
  .legal p { color: #7d8b99; font-size: 0.78rem; margin: 0; }
</style>
