---
// Features section component
const features = [
  {
    title: "Virtual Portfolio First",
    description: "Start with $10,000 virtual funds. Test strategies, prove profitability, then graduate to real money trading.",
    icon: "wallet",
    color: "primary"
  },
  {
    title: "6-Layer AI Decision Engine",
    description: "Market regime detection, LSTM predictions, reversal signals, smart filters, confidence scoring, and adaptive timing.",
    icon: "brain",
    color: "profit"
  },
  {
    title: "24/7 Autonomous Trading",
    description: "AI monitors markets continuously, executes trades based on signals, manages risk automatically while you sleep.",
    icon: "clock",
    color: "warning"
  },
  {
    title: "Real-Time Performance Tracking",
    description: "Track every trade, see P&L breakdown, analyze win rates, and monitor portfolio performance in real-time.",
    icon: "chart",
    color: "primary"
  },
  {
    title: "Transparent AI vs Random",
    description: "Compare AI performance against random trading. See statistical significance and confidence intervals.",
    icon: "comparison",
    color: "profit"
  },
  {
    title: "Risk Management Built-In",
    description: "Automatic stop losses, position sizing, circuit breakers, and drawdown protection keep your capital safe.",
    icon: "shield",
    color: "warning"
  }
];

const getIcon = (iconName: string) => {
  const icons = {
    wallet: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z',
    brain: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    clock: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    comparison: 'M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2',
    shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  };
  return icons[iconName] || icons.chart;
};

const getColorClasses = (color: string) => {
  const colors = {
    primary: {
      bg: 'bg-primary-100 dark:bg-primary-900/30',
      icon: 'bg-primary-500',
      text: 'text-primary-600 dark:text-primary-400'
    },
    profit: {
      bg: 'bg-profit-100 dark:bg-profit-900/30',
      icon: 'bg-profit-500',
      text: 'text-profit-600 dark:text-profit-400'
    },
    warning: {
      bg: 'bg-warning-100 dark:bg-warning-900/30',
      icon: 'bg-warning-500',
      text: 'text-warning-600 dark:text-warning-400'
    }
  };
  return colors[color] || colors.primary;
};
---

<section class="py-20 bg-gray-50 dark:bg-dark-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Everything You Need to Trade Smarter
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Our platform combines cutting-edge AI with proven risk management to help you achieve consistent trading profits.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => {
        const colorClasses = getColorClasses(feature.color);
        return (
          <div class="bg-white dark:bg-dark-900 p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-200 dark:border-dark-700">
            <div class={`w-12 h-12 ${colorClasses.icon} rounded-lg flex items-center justify-center mb-4`}>
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getIcon(feature.icon)} />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
              {feature.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              {feature.description}
            </p>
          </div>
        );
      })}
    </div>
    
    <!-- How It Works Section -->
    <div class="mt-20">
      <div class="text-center mb-12">
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
          How TradePulse.AI Works
        </h3>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          From virtual portfolio to real money in 4 simple steps
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-primary-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-xl font-bold">1</span>
          </div>
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Sign Up & Start Virtual</h4>
          <p class="text-gray-600 dark:text-gray-300 text-sm">
            Create account and receive $10,000 virtual portfolio to test our AI trading system.
          </p>
        </div>
        
        <!-- Step 2 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-profit-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-xl font-bold">2</span>
          </div>
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">AI Trades for You</h4>
          <p class="text-gray-600 dark:text-gray-300 text-sm">
            Our 6-layer AI system analyzes markets 24/7 and executes trades automatically.
          </p>
        </div>
        
        <!-- Step 3 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-warning-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-xl font-bold">3</span>
          </div>
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Prove Profitability</h4>
          <p class="text-gray-600 dark:text-gray-300 text-sm">
            Demonstrate consistent profits over 90+ days with proper risk management.
          </p>
        </div>
        
        <!-- Step 4 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-xl font-bold">4</span>
          </div>
          <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Graduate to Real Money</h4>
          <p class="text-gray-600 dark:text-gray-300 text-sm">
            Once approved, transition to real money trading with enhanced risk controls.
          </p>
        </div>
      </div>
      
      <!-- Progress Timeline -->
      <div class="mt-12 bg-white dark:bg-dark-900 p-6 rounded-xl">
        <h4 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 text-center">
          Your Journey to Real Money Trading
        </h4>
        <div class="flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0">
          <div class="flex items-center">
            <div class="w-8 h-8 bg-primary-500 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">✓</div>
            <div>
              <div class="font-medium text-gray-900 dark:text-white">Virtual Portfolio</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">$10,000 starting balance</div>
            </div>
          </div>
          
          <div class="hidden md:block flex-1 h-px bg-gray-300 dark:bg-dark-600 mx-4"></div>
          
          <div class="flex items-center">
            <div class="w-8 h-8 bg-warning-500 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">90</div>
            <div>
              <div class="font-medium text-gray-900 dark:text-white">Proof Period</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">90 days consistent profit</div>
            </div>
          </div>
          
          <div class="hidden md:block flex-1 h-px bg-gray-300 dark:bg-dark-600 mx-4"></div>
          
          <div class="flex items-center">
            <div class="w-8 h-8 bg-profit-500 rounded-full flex items-center justify-center text-white text-sm font-bold mr-3">$</div>
            <div>
              <div class="font-medium text-gray-900 dark:text-white">Real Money</div>
              <div class="text-sm text-gray-500 dark:text-gray-400">Live trading approved</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 