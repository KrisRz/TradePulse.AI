---
export const prerender = true;

// Import the register form component
import RegisterForm from '../../components/shared/auth/RegisterForm.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Sign Up - TradePulse.AI">
  <main class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
      <div class="text-center">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
          🚀 TradePulse.AI
        </h1>
        <h2 class="mt-6 text-2xl font-bold text-gray-900 dark:text-white">
          Create your account
        </h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Or{' '}
          <a href="/auth/login" class="font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400">
            sign in to your existing account
          </a>
        </p>
      </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white dark:bg-gray-800 py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-200 dark:border-gray-700">
        <RegisterForm client:load />
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="text-xs text-gray-500 dark:text-gray-400">
        By signing up, you agree to our{' '}
        <a href="#" class="text-blue-600 hover:text-blue-500 dark:text-blue-400">Terms of Service</a>
        {' '}and{' '}
        <a href="#" class="text-blue-600 hover:text-blue-500 dark:text-blue-400">Privacy Policy</a>
      </p>
    </div>
  </main>
</BaseLayout>
