---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Hero from '../components/astro/Hero.astro';
import Features from '../components/astro/Features.astro';
import Stats from '../components/astro/Stats.astro';
import Footer from '../components/astro/Footer.astro';
---

<BaseLayout title="TradePulse.AI - AI-Powered Crypto Day Trading Platform">
  <Header />
  
  <main class="overflow-hidden">
    <Hero />
    <Stats />
    <Features />
    
    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-primary-600 to-primary-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Ready to Start AI-Powered Trading?
        </h2>
        <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
          Follow a walk-forward validated strategy on a virtual portfolio.
          No real money at risk while the system proves itself in live paper trading.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/auth/login" 
            class="bg-white text-primary-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors focus-ring"
          >
            Start Trading Now
          </a>
          <a 
            href="/auth/register" 
            class="border border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors focus-ring"
          >
            Create Free Account
          </a>
        </div>
      </div>
    </section>
    
  </main>
  
  <Footer />
</BaseLayout>

<style>
  /* Custom animations for landing page */
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  /* Gradient text animation */
  .text-gradient-animate {
    background: linear-gradient(-45deg, #3b82f6, #1d4ed8, #6366f1, #8b5cf6);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style> 