---
import { TradingViewChart } from '../../components/shared/charts';
export const prerender = false;

// Check if user is authenticated and NOT admin
const isUser = true; // In real app, check auth from cookies/session
const isAdmin = false; // In real app, check if user has admin role

if (!isUser) {
  return Astro.redirect('/auth/login');
}

// Redirect admin users to admin dashboard
if (isAdmin) {
  return Astro.redirect('/admin/dashboard');
}

// Fetch real portfolio data from backend - NO HARDCODED VALUES!
let portfolioData = null;
let fetchError = null;

try {
  // Get auth token from cookies or headers
  const authToken = Astro.cookies.get('auth_token')?.value ||
                   Astro.request.headers.get('authorization')?.replace('Bearer ', '') ||
                   'enterprise_admin_token'; // Development fallback

  if (!authToken) {
    throw new Error('No authentication token available');
  }

  // Fetch real portfolio data from backend (using available analytics endpoint)
  const response = await fetch('/api/analytics/signals/metrics', {
    headers: {
      'Authorization': `Bearer ${authToken}`,
      'Content-Type': 'application/json'
    }
  });

  if (response.ok) {
    portfolioData = await response.json();
    console.log('✅ Astro: Loaded real portfolio data');
  } else {
    throw new Error(`Backend API error: ${response.status}`);
  }

} catch (error) {
  console.error('❌ Astro: Failed to fetch portfolio data:', error);
  fetchError = error instanceof Error ? error.message : 'Failed to load portfolio data';
  // NO FALLBACKS - keep null to show error state
  portfolioData = null;
}

// Helper functions for formatting
function formatCurrency(amount: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD'
  }).format(amount);
}

function formatPercentage(value: number): string {
  return `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`;
}

function calculatePercentage(value: number, total: number): number {
  return total > 0 ? (value / total) * 100 : 0;
}
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portfolio View - TradePulse.AI</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eff6ff',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            }
          }
        }
      }
    }
  </script>
  
  <!-- Dark mode script -->
  <script>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
  </script>
</head>

<body class="bg-gray-50 dark:bg-gray-900 min-h-screen">
  <!-- Navigation Header -->
  <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center space-x-4">
          <a href="/user_dashboard" class="text-blue-600 hover:text-blue-800 dark:text-blue-400">
            ← Back to Dashboard
          </a>
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-gray-900 dark:text-white">
              💰 Portfolio View
            </h1>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <div class="text-sm text-gray-600 dark:text-gray-400">
            👤 trader1@example.com
          </div>
          <a href="/auth/login" class="text-sm text-red-600 hover:text-red-800 dark:text-red-400">
            Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    
    <!-- Portfolio Overview -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
            Your Portfolio Performance
          </h2>
          
          <!-- Portfolio Stats -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            {fetchError || !portfolioData ? (
              <div class="col-span-full bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
                <div class="flex items-center">
                  <div class="text-red-600 dark:text-red-400 text-sm font-medium">
                    ❌ Unable to load real portfolio data
                  </div>
                </div>
                {fetchError && (
                  <div class="mt-2 text-red-600 dark:text-red-400 text-xs">
                    Error: {fetchError}
                  </div>
                )}
                <div class="mt-4">
                  <button onclick="location.reload()" class="px-4 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700 transition-colors">
                    Retry
                  </button>
                </div>
              </div>
            ) : (
              <>
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-6 rounded-lg text-white">
                  <div class="text-blue-100 text-sm font-medium">Total Portfolio Value</div>
                  <div class="text-3xl font-bold">{formatCurrency(portfolioData.totalValue || 0)}</div>
                  <div class="text-blue-100 text-sm mt-1">Virtual Trading Account</div>
                </div>

                <div class="bg-gradient-to-r from-green-500 to-green-600 p-6 rounded-lg text-white">
                  <div class="text-green-100 text-sm font-medium">Total P&L</div>
                  <div class="text-3xl font-bold">{formatCurrency(portfolioData.totalPnL || 0)}</div>
                  <div class="text-green-100 text-sm mt-1">{formatPercentage(portfolioData.totalReturnPercentage || 0)} Return</div>
                </div>

                <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-6 rounded-lg text-white">
                  <div class="text-purple-100 text-sm font-medium">Win Rate</div>
                  <div class="text-3xl font-bold">{(portfolioData.winRate || 0).toFixed(1)}%</div>
                  <div class="text-purple-100 text-sm mt-1">AI-Assisted Trading</div>
                </div>
              </>
            )}
          </div>

          <!-- Portfolio Breakdown -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            
            <!-- Asset Allocation -->
            <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Asset Allocation</h3>
              <div class="space-y-4">
                {portfolioData?.assetAllocation && portfolioData.assetAllocation.length > 0 ? (
                  portfolioData.assetAllocation.map((asset: any) => {
                    const colors = ['bg-orange-500', 'bg-blue-500', 'bg-green-500', 'bg-purple-500', 'bg-red-500'];
                    const colorIndex = portfolioData.assetAllocation.indexOf(asset) % colors.length;

                    return (
                      <div class="flex items-center justify-between">
                        <div class="flex items-center">
                          <div class={`w-4 h-4 ${colors[colorIndex]} rounded mr-3`}></div>
                          <span class="text-sm font-medium text-gray-900 dark:text-white">
                            {asset.symbol} ({asset.name})
                          </span>
                        </div>
                        <div class="text-right">
                          <div class="text-sm font-semibold text-gray-900 dark:text-white">
                            {formatCurrency(asset.value)}
                          </div>
                          <div class="text-xs text-gray-500 dark:text-gray-400">
                            {asset.percentage.toFixed(1)}%
                          </div>
                        </div>
                      </div>
                    );
                  })
                ) : (
                  <div class="text-center py-4">
                    <div class="text-gray-500 dark:text-gray-400 text-sm">
                      No asset allocation data available
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Recent Trades -->
            <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recent Trades</h3>
              <div class="space-y-3">
                {portfolioData?.recentTrades && portfolioData.recentTrades.length > 0 ? (
                  portfolioData.recentTrades.slice(0, 5).map((trade: any) => {
                    const pnlColor = trade.pnl >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400';
                    const actionColor = trade.action === 'BUY' ? 'text-green-600 dark:text-green-400' : 'text-blue-600 dark:text-blue-400';

                    const formatTime = (timestamp: string) => {
                      const date = new Date(timestamp);
                      const now = new Date();
                      const diffMs = now.getTime() - date.getTime();
                      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                      const diffDays = Math.floor(diffHours / 24);

                      if (diffHours < 24) {
                        return `${diffHours}h ago`;
                      } else {
                        return `${diffDays}d ago`;
                      }
                    };

                    return (
                      <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-b-0">
                        <div>
                          <div class="text-sm font-medium text-gray-900 dark:text-white">{trade.symbol}</div>
                          <div class={`text-xs ${actionColor}`}>
                            {trade.action} • {trade.signalSource}
                          </div>
                        </div>
                        <div class="text-right">
                          <div class={`text-sm font-semibold ${pnlColor}`}>
                            {formatCurrency(trade.pnl)}
                          </div>
                          <div class="text-xs text-gray-500 dark:text-gray-400">
                            {formatTime(trade.timestamp)}
                          </div>
                        </div>
                      </div>
                    );
                  })
                ) : (
                  <div class="text-center py-4">
                    <div class="text-gray-500 dark:text-gray-400 text-sm">
                      No recent trades available
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>

          <!-- Live Market Chart -->
          <div class="mt-8">
            <TradingViewChart 
              symbol="BTCUSDT" 
              defaultInterval="1h" 
              height={400} 
              showToolbar={true}
              client:load
            />
          </div>

        </div>
      </div>
    </div>
  </div>
</body>
</html>
