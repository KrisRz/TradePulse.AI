---
import { TradingViewChart } from '../../components/shared/charts';
import PortfolioOverview from '../../components/user/portfolio/PortfolioOverview.tsx';
export const prerender = true;

// The site is built with output: 'static', so authentication is enforced
// client-side (inline guard script below), exactly like user_dashboard/index.astro.
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portfolio View - TradePulse.AI</title>

  <!--
    Client-side auth guard. Any logged-in user (valid, unexpired JWT) may view
    this page; otherwise redirect to login. The page stays hidden until the
    check passes to avoid flashing content.
  -->
  <script is:inline>
    (function () {
      document.documentElement.style.visibility = 'hidden';
      try {
        var token = localStorage.getItem('token');
        if (!token) {
          location.replace('/auth/login');
          return;
        }
        var payloadPart = (token.split('.')[1] || '').replace(/-/g, '+').replace(/_/g, '/');
        var payload = JSON.parse(atob(payloadPart));
        if (payload.exp && payload.exp <= Date.now() / 1000) {
          location.replace('/auth/login');
          return;
        }
        // Check passed - reveal the page and show the logged-in user's identity
        document.documentElement.style.visibility = '';
        document.addEventListener('DOMContentLoaded', function () {
          var el = document.getElementById('user-email');
          if (el && (payload.email || payload.username)) {
            el.textContent = payload.email || payload.username;
          }
        });
      } catch (e) {
        location.replace('/auth/login');
      }
    })();
  </script>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eff6ff',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            }
          }
        }
      }
    }
  </script>

  <!-- Dark mode script -->
  <script>
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
  </script>
</head>

<body class="bg-gray-50 dark:bg-gray-900 min-h-screen">
  <!-- Navigation Header -->
  <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center space-x-4">
          <a href="/user_dashboard" class="text-blue-600 hover:text-blue-800 dark:text-blue-400">
            ← Back to Dashboard
          </a>
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-gray-900 dark:text-white">
              💰 Portfolio View
            </h1>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          <!-- User Info (filled client-side from the JWT payload) -->
          <div class="text-sm text-gray-600 dark:text-gray-400">
            👤 <span id="user-email"></span>
          </div>
          <a href="/auth/login" class="text-sm text-red-600 hover:text-red-800 dark:text-red-400">
            Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">

    <!-- Portfolio Overview -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
            Your Portfolio Performance
          </h2>

          <!-- Portfolio stats + recent trades (live data fetched client-side) -->
          <PortfolioOverview client:load />

          <!-- Live Market Chart -->
          <div class="mt-8">
            <TradingViewChart
              symbol="BTCUSDT"
              defaultInterval="1h"
              height={400}
              showToolbar={true}
              client:load
            />
          </div>

        </div>
      </div>
    </div>
  </div>
</body>
</html>
