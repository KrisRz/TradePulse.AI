---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
// import SignalFeed from '../../components/signals/SignalFeed';
// import SignalFilters from '../../components/signals/SignalFilters';
// import SignalAnalytics from '../../components/signals/SignalAnalytics';
// import LiveSignalStatus from '../../components/signals/LiveSignalStatus';
// import ConfidenceScore from '../../components/signals/ConfidenceScore';
---

<DashboardLayout title="Trading Signals - TradePulse.AI">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">AI Trading Signals</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">
          Real-time AI-powered trading signals and analysis
        </p>
      </div>
    </div>

    <!-- Signals content placeholder -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Live Signal Feed</h2>
          <p class="text-gray-600 dark:text-gray-300">Signal components loading...</p>
        </div>
      </div>
      
      <div class="lg:col-span-1">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Signal Analytics</h2>
          <p class="text-gray-600 dark:text-gray-300">Analytics components loading...</p>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout> 