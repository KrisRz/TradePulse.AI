---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TradingViewChart } from '../../components/shared/charts';

export const prerender = true;

// Check if user is authenticated and NOT admin
const isUser = true; // In real app, check auth from cookies/session
const isAdmin = false; // In real app, check if user has admin role

if (!isUser) {
  return Astro.redirect('/auth/login');
}

// Redirect admin users to admin dashboard
if (isAdmin) {
  return Astro.redirect('/admin/dashboard');
}

// Skip SSR fetch - data will be loaded client-side by React components
// SSR fetch with relative URLs fails during build time
let userDashboardData = null;
let fetchError = null;

// Helper function to format currency
function formatCurrency(amount: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD'
  }).format(amount);
}

// Helper function to format percentage
function formatPercentage(value: number | undefined | null): string {
  if (value === undefined || value === null || isNaN(value)) {
    return '0.00%';
  }
  return `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`;
}
---

<BaseLayout title="User Dashboard - TradePulse.AI">
  <!-- Navigation Header -->
  <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-gray-900 dark:text-white">
              🚀 TradePulse.AI - User Dashboard
            </h1>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- User Info -->
          <div class="text-sm text-gray-600 dark:text-gray-400">
            👤 trader1@example.com
          </div>
          
          <!-- Dark Mode Toggle -->
          <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
          
          <!-- Logout -->
          <a href="/auth/login" class="text-sm text-red-600 hover:text-red-800 dark:text-red-400">
            Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Welcome Section -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Welcome to Your Trading Dashboard
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Access your portfolio, trading signals, and analytics with AI-powered insights.
          </p>
          
          <!-- Quick Stats -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            {fetchError || !userDashboardData ? (
              <div class="col-span-full bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
                <div class="flex items-center">
                  <div class="text-red-600 dark:text-red-400 text-sm font-medium">
                    ❌ Unable to load real dashboard data
                  </div>
                </div>
                {fetchError && (
                  <div class="mt-2 text-red-600 dark:text-red-400 text-xs">
                    Error: {fetchError}
                  </div>
                )}
                <div class="mt-4">
                  <button onclick="location.reload()" class="px-4 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700 transition-colors">
                    Retry
                  </button>
                </div>
              </div>
            ) : (
              <>
                <div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg">
                  <div class="text-blue-600 dark:text-blue-400 text-sm font-medium">Portfolio Value</div>
                  <div class="text-2xl font-bold text-blue-900 dark:text-blue-100">
                    {formatCurrency(userDashboardData?.portfolioValue || 0)}
                  </div>
                </div>
                <div class="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg">
                  <div class="text-green-600 dark:text-green-400 text-sm font-medium">Today's P&L</div>
                  <div class="text-2xl font-bold text-green-900 dark:text-green-100">
                    {formatCurrency(userDashboardData?.dailyPnL || 0)}
                  </div>
                  <div class="text-green-600 dark:text-green-400 text-xs">
                    {formatPercentage(userDashboardData?.dailyPnLPercentage)}
                  </div>
                </div>
                <div class="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-lg">
                  <div class="text-purple-600 dark:text-purple-400 text-sm font-medium">Active Signals</div>
                  <div class="text-2xl font-bold text-purple-900 dark:text-purple-100">
                    {userDashboardData?.activeSignals || 0}
                  </div>
                  <div class="text-purple-600 dark:text-purple-400 text-xs">
                    AI Generated
                  </div>
                </div>
                <div class="bg-orange-50 dark:bg-orange-900/20 p-4 rounded-lg">
                  <div class="text-orange-600 dark:text-orange-400 text-sm font-medium">Win Rate</div>
                  <div class="text-2xl font-bold text-orange-900 dark:text-orange-100">
                    {(userDashboardData?.winRate || 0).toFixed(1)}%
                  </div>
                  <div class="text-orange-600 dark:text-orange-400 text-xs">
                    Last 30 days
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- User Dashboard Features (4 Permissions) -->
    <div class="px-4 py-6 sm:px-0">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1. User Dashboard -->
        <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-md flex items-center justify-center">
                  📊
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Dashboard Overview</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Main dashboard view</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-blue-600 dark:text-blue-400 font-medium">
                ✅ Current Page
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Portfolio View -->
        <a href="/user_dashboard/portfolio" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-md flex items-center justify-center">
                  💰
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Portfolio View</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">View your portfolio performance</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-green-600 dark:text-green-400 font-medium">
                View Portfolio →
              </div>
            </div>
          </div>
        </a>

        <!-- 3. Trading Signals -->
        <a href="/user_dashboard/signals" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900 rounded-md flex items-center justify-center">
                  📡
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Trading Signals</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">AI-powered trading signals</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-purple-600 dark:text-purple-400 font-medium">
                View Signals →
              </div>
            </div>
          </div>
        </a>

        <!-- 4. Basic Analytics -->
        <a href="/user_dashboard/analytics" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-md flex items-center justify-center">
                  📈
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Basic Analytics</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Performance analytics</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-orange-600 dark:text-orange-400 font-medium">
                View Analytics →
              </div>
            </div>
          </div>
        </a>

      </div>
    </div>

    <!-- Live BTC Chart Section -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
              📊 Live Bitcoin Price Chart
            </h3>
            <span class="text-sm text-green-500 dark:text-green-400 flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse mr-2"></div>
              Live Data
            </span>
          </div>
          
          <div class="bg-gray-50 dark:bg-gray-900 rounded-lg">
            <TradingViewChart 
              symbol="BTCUSDT" 
              defaultInterval="15m" 
              height={350} 
              showToolbar={true}
              client:load
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Recent Activity</h3>
          <div class="space-y-3">
            {userDashboardData?.recentActivity && userDashboardData.recentActivity.length > 0 ? (
              userDashboardData.recentActivity.slice(0, 5).map((activity: any) => {
                const getActivityColor = (type: string) => {
                  switch (type) {
                    case 'signal': return 'bg-green-500';
                    case 'portfolio': return 'bg-blue-500';
                    case 'ai': return 'bg-purple-500';
                    case 'trade': return 'bg-orange-500';
                    default: return 'bg-gray-500';
                  }
                };

                const getActivityIcon = (type: string) => {
                  switch (type) {
                    case 'signal': return '📈';
                    case 'portfolio': return '💰';
                    case 'ai': return '🤖';
                    case 'trade': return '⚡';
                    default: return '📝';
                  }
                };

                const formatTime = (timestamp: string) => {
                  const date = new Date(timestamp);
                  const now = new Date();
                  const diffMs = now.getTime() - date.getTime();
                  const diffMins = Math.floor(diffMs / (1000 * 60));

                  if (diffMins < 60) {
                    return `${diffMins} min ago`;
                  } else if (diffMins < 1440) {
                    return `${Math.floor(diffMins / 60)}h ago`;
                  } else {
                    return `${Math.floor(diffMins / 1440)}d ago`;
                  }
                };

                return (
                  <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-700 last:border-b-0">
                    <div class="flex items-center">
                      <div class={`w-2 h-2 rounded-full mr-3 ${getActivityColor(activity.type)}`}></div>
                      <span class="text-sm text-gray-900 dark:text-white">
                        {getActivityIcon(activity.type)} {activity.message}
                      </span>
                    </div>
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      {formatTime(activity.timestamp)}
                    </span>
                  </div>
                );
              })
            ) : (
              <div class="text-center py-4">
                <div class="text-gray-500 dark:text-gray-400 text-sm">
                  {fetchError ? 'Unable to load recent activity' : 'No recent activity available'}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dark mode toggle script -->
  <script>
    document.getElementById('theme-toggle').addEventListener('click', function() {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
      } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
      }
    });
  </script>
</BaseLayout>