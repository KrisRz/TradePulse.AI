---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TradingViewChart } from '../../components/shared/charts';
import UserDashboardOverview from '../../components/user/dashboard/UserDashboardOverview.tsx';

export const prerender = true;
---

<BaseLayout title="User Dashboard - TradePulse.AI">
  <!--
    Client-side auth guard. The site is built with output: 'static', so auth must
    be enforced in the browser: any logged-in user (valid, unexpired JWT) may view
    this page; otherwise redirect to login. The page stays hidden until the check
    passes to avoid flashing content.
  -->
  <script is:inline>
    (function () {
      document.documentElement.style.visibility = 'hidden';
      try {
        var token = localStorage.getItem('token');
        if (!token) {
          location.replace('/auth/login');
          return;
        }
        var payloadPart = (token.split('.')[1] || '').replace(/-/g, '+').replace(/_/g, '/');
        var payload = JSON.parse(atob(payloadPart));
        if (payload.exp && payload.exp <= Date.now() / 1000) {
          location.replace('/auth/login');
          return;
        }
        // Check passed - reveal the page and show the logged-in user's identity
        document.documentElement.style.visibility = '';
        document.addEventListener('DOMContentLoaded', function () {
          var el = document.getElementById('user-email');
          if (el && (payload.email || payload.username)) {
            el.textContent = payload.email || payload.username;
          }
        });
      } catch (e) {
        location.replace('/auth/login');
      }
    })();
  </script>
  <!-- Navigation Header -->
  <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <h1 class="text-xl font-bold text-gray-900 dark:text-white">
              🚀 TradePulse.AI - User Dashboard
            </h1>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <!-- User Info (filled client-side from the JWT payload) -->
          <div class="text-sm text-gray-600 dark:text-gray-400">
            👤 <span id="user-email"></span>
          </div>
          
          <!-- Dark Mode Toggle -->
          <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
          
          <!-- Logout -->
          <a href="/auth/login" class="text-sm text-red-600 hover:text-red-800 dark:text-red-400">
            Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Welcome Section -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Welcome to Your Trading Dashboard
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Access your portfolio, trading signals, and analytics with AI-powered insights.
          </p>
          
          <!-- Quick Stats + Trading Activity (live data fetched client-side) -->
          <UserDashboardOverview client:load />
        </div>
      </div>
    </div>

    <!-- User Dashboard Features (4 Permissions) -->
    <div class="px-4 py-6 sm:px-0">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1. User Dashboard -->
        <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-md flex items-center justify-center">
                  📊
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Dashboard Overview</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Main dashboard view</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-blue-600 dark:text-blue-400 font-medium">
                ✅ Current Page
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Portfolio View -->
        <a href="/user_dashboard/portfolio" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-green-100 dark:bg-green-900 rounded-md flex items-center justify-center">
                  💰
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Portfolio View</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">View your portfolio performance</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-green-600 dark:text-green-400 font-medium">
                View Portfolio →
              </div>
            </div>
          </div>
        </a>

        <!-- 3. Trading Signals -->
        <a href="/user_dashboard/signals" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-purple-100 dark:bg-purple-900 rounded-md flex items-center justify-center">
                  📡
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Trading Signals</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">AI-powered trading signals</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-purple-600 dark:text-purple-400 font-medium">
                View Signals →
              </div>
            </div>
          </div>
        </a>

        <!-- 4. Basic Analytics -->
        <a href="/user_dashboard/analytics" class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg hover:shadow-lg transition-shadow">
          <div class="p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-orange-100 dark:bg-orange-900 rounded-md flex items-center justify-center">
                  📈
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Basic Analytics</h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">Performance analytics</p>
              </div>
            </div>
            <div class="mt-4">
              <div class="text-sm text-orange-600 dark:text-orange-400 font-medium">
                View Analytics →
              </div>
            </div>
          </div>
        </a>

      </div>
    </div>

    <!-- Live BTC Chart Section -->
    <div class="px-4 py-6 sm:px-0">
      <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white flex items-center">
              📊 Live Bitcoin Price Chart
            </h3>
            <span class="text-sm text-green-500 dark:text-green-400 flex items-center">
              <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse mr-2"></div>
              Live Data
            </span>
          </div>
          
          <div class="bg-gray-50 dark:bg-gray-900 rounded-lg">
            <TradingViewChart 
              symbol="BTCUSDT" 
              defaultInterval="15m" 
              height={350} 
              showToolbar={true}
              client:load
            />
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Dark mode toggle script -->
  <script>
    document.getElementById('theme-toggle').addEventListener('click', function() {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
      } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
      }
    });
  </script>
</BaseLayout>