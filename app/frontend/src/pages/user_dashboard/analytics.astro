---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
// import PerformanceComparison from '../../components/analytics/PerformanceComparison';
// import PnLChart from '../../components/analytics/PnLChart';
// import TradingHeatmap from '../../components/analytics/TradingHeatmap';
// import MetricsGrid from '../../components/analytics/MetricsGrid';
// import { DrawdownChart } from '../../components/charts/DrawdownChart';
// import WinRateAnalysis from '../../components/analytics/WinRateAnalysis';
---

<DashboardLayout title="Performance Analytics - TradePulse.AI">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Performance Analytics</h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">
          Comprehensive analysis of your AI trading performance
        </p>
      </div>
    </div>

    <!-- Analytics content placeholder -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Performance Metrics</h2>
        <p class="text-gray-600 dark:text-gray-300">Analytics components loading...</p>
      </div>
      
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Trading Analysis</h2>
        <p class="text-gray-600 dark:text-gray-300">Analysis components loading...</p>
      </div>
    </div>
  </div>
</DashboardLayout> 