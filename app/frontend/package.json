{
  "name": "@tradepulse/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port ${PORT:-4321}",
    "start": "astro dev --port ${PORT:-4321}",
    "build": "astro build",
    "build:prod": "NODE_ENV=production astro build",
    "preview": "astro preview",
    "serve": "astro preview --port ${PORT:-4321} --host 0.0.0.0",
    "astro": "astro",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:update": "jest --updateSnapshot",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install",
    "test:a11y": "node scripts/accessibility-audit.mjs",
    "test:a11y:storybook": "npm run storybook -- --ci & wait-on http://localhost:6006 && npx storybook-test-runner --stories-json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "lint:a11y": "eslint . --ext .jsx,.tsx --rule 'jsx-a11y/*: error'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "npx http-server storybook-static"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.3",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/preact": "^3.5.3",
    "@astrojs/tailwind": "^5.1.2",
    "@preact/signals": "^1.3.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "astro": "^5.13.5",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lightningcss": "^1.30.1",
    "lightweight-charts": "^5.0.8",
    "lucide-preact": "^0.456.0",
    "preact": "^10.24.3",
    "react-tradingview-widget": "^1.3.2",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.14",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx-source": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/preact": "^8.4.7",
    "@storybook/preact-vite": "^8.4.7",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.2",
    "babel-jest": "^29.7.0",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "playwright": "^1.49.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "storybook": "^8.4.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
