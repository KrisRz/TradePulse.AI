# TradePulse.AI Production Environment Configuration
# Copy this file to production.env and fill in real values

# Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Application
APP_NAME=TradePulse.AI
APP_VERSION=1.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=9002
API_WORKERS=4

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-must-be-at-least-32-characters-long-and-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["https://tradepulse.ai","https://app.tradepulse.ai"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE"]
ALLOWED_HEADERS=["Authorization","Content-Type"]
ALLOW_CREDENTIALS=true

# Database - AWS DynamoDB
DYNAMODB_REGION=us-east-1
DB_MAX_CONNECTIONS=50
DB_CONNECTION_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_MAX_RETRIES=3

# External Services - Production
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BINANCE_TESTNET=false
BINANCE_TIMEOUT=10

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Model Storage
MODEL_BUCKET=tradepulse-models-prod
MODEL_CACHE_TTL=3600

# Feature Flags - Production
ENABLE_LIVE_TRADING=true
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
ENABLE_AI_MODELS=true
ENABLE_MODEL_TRAINING=false
ENABLE_AUTO_REBALANCING=true
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_ADMIN_API=true
ENABLE_DEBUG_ENDPOINTS=false

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

