# TradePulse.AI Development Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Application
APP_NAME=TradePulse.AI
APP_VERSION=1.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=9002
API_WORKERS=1

# Security
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:4321","http://localhost:3000","http://127.0.0.1:4321"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true

# Database - DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30
DB_READ_TIMEOUT=60
DB_MAX_RETRIES=3

# External Services - Development
BINANCE_API_KEY=bWgI1vnxd9R4lIGMouwlHyuDxTkvAlxkEGcSVdsC4MehZ3HPDXwGLjbDc8c2rtBz
BINANCE_SECRET_KEY=VDFuE0f5PYtDKNZ3S4LWt1nZySQlHEg3yvVdwEt96UHGxRdBAzAyNSCz0Tv3pJ1Q
BINANCE_TESTNET=false
BINANCE_TIMEOUT=30

# AWS (for development, use local credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-dev-key
AWS_SECRET_ACCESS_KEY=local-dev-secret

# Feature Flags - Development
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
ENABLE_AI_MODELS=true
ENABLE_MODEL_TRAINING=false
ENABLE_AUTO_REBALANCING=false
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=true
ENABLE_ADMIN_API=true
ENABLE_DEBUG_ENDPOINTS=true

# Professional Mode Configuration
PROFESSIONAL_MODE=true
DAY_TRADING_MODE=true
TRADING_SESSION_VALIDATION=false

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

