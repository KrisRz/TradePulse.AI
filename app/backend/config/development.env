# TradePulse.AI Development Environment Configuration

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Application
APP_NAME=TradePulse.AI
APP_VERSION=1.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=9002
API_WORKERS=1

# Security
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:4321","http://localhost:3000","http://127.0.0.1:4321"]
ALLOWED_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true

# Database - DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30
DB_READ_TIMEOUT=60
DB_MAX_RETRIES=3

# External Services - Development (ENABLE FOR LIVE TRADING)
USE_BINANCE_AUTH=true
ENABLE_PRIVATE_BINANCE=true
# LIVE TRADING API KEYS - ENABLED FOR SMALL TRADES
BINANCE_API_KEY=HDV3cd7CnFwQoauVEpaed6nroXtqgA4t098Ymv04XGkO4ILfUavcMxJPE7YzfYW8
BINANCE_SECRET_KEY=cnSUgXwZuHgOh6C3f9SHI12sUkDIjz3iaIhHKCm5O2dWmOnkIq8VcduNNJyhrsZy
BINANCE_TESTNET=false
BINANCE_TIMEOUT=30

# AWS (for development, use local credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-dev-key
AWS_SECRET_ACCESS_KEY=local-dev-secret

# Feature Flags - Development (OPTIMIZED FOR SMALL TRADES)
ENABLE_LIVE_TRADING=true
ENABLE_PAPER_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_AI_MODELS=true
ENABLE_MODEL_TRAINING=false
ENABLE_AUTO_REBALANCING=false
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=true
ENABLE_ADMIN_API=true
ENABLE_DEBUG_ENDPOINTS=true

# Professional Mode Configuration (SMALL TRADES OPTIMIZATION)
PROFESSIONAL_MODE=true
DAY_TRADING_MODE=true
SCALPING_MODE=true
TRADING_SESSION_VALIDATION=false
# Development optimizations
BYPASS_ENTRY_WARMUP=true
ENTRY_WARMUP_SECONDS_TOTAL=30

# TensorFlow Configuration (MUTEX DEADLOCK FIX)
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
TF_USE_LEGACY_KERAS=1
TF_NUM_INTEROP_THREADS=1
TF_NUM_INTRAOP_THREADS=1
TF_DISABLE_MKL=1
CUDA_VISIBLE_DEVICES=""

# Entry Cooldown - AGGRESSIVE SCALPING
ENTRY_COOLDOWN_SECONDS=3

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

