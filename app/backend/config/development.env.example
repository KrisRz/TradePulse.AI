# TradePulse.AI — development environment (EXAMPLE)
# Copy to `development.env` and fill in real values. `development.env` is
# git-ignored and must NEVER be committed (it holds live secrets).

# --- App ---
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=TradePulse.AI
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=9002
API_WORKERS=1

# --- Security ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-48-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*
ALLOW_CREDENTIALS=true

# --- Database (DynamoDB Local for dev) ---
DYNAMODB_REGION=eu-west-2
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=5
DB_READ_TIMEOUT=5
DB_MAX_RETRIES=3

# --- Binance ---
# Use TESTNET keys for development. Live keys belong only in SSM in production.
USE_BINANCE_AUTH=false
ENABLE_PRIVATE_BINANCE=false
BINANCE_API_KEY=your-binance-testnet-api-key
BINANCE_SECRET_KEY=your-binance-testnet-secret-key
BINANCE_TESTNET=true
BINANCE_TIMEOUT=10

# --- AWS (dev: leave blank to use DynamoDB Local / default provider chain) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Feature flags ---
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
ENABLE_AI_MODELS=true
ENABLE_MODEL_TRAINING=false
ENABLE_AUTO_REBALANCING=false
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_PROFILING=false
ENABLE_ADMIN_API=true
ENABLE_DEBUG_ENDPOINTS=true

# --- Trading modes ---
PROFESSIONAL_MODE=false
DAY_TRADING_MODE=true
SCALPING_MODE=false
TRADING_SESSION_VALIDATION=true
BYPASS_ENTRY_WARMUP=true
ENTRY_WARMUP_SECONDS_TOTAL=60
ENTRY_COOLDOWN_SECONDS=30

# --- TensorFlow / runtime tuning ---
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
TF_USE_LEGACY_KERAS=1
TF_NUM_INTEROP_THREADS=1
TF_NUM_INTRAOP_THREADS=1
TF_DISABLE_MKL=1
CUDA_VISIBLE_DEVICES=

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
