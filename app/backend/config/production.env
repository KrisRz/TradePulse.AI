# TradePulse.AI Production Configuration
# Optimized for AWS App Runner deployment

# Environment
ENVIRONMENT=prod

# Server Configuration
HOST=0.0.0.0
PORT=9002

# Database - AWS DynamoDB
DYNAMODB_ENDPOINT=  # Empty = use AWS DynamoDB
DYNAMODB_REGION=eu-west-2
DYNAMODB_TABLE_PREFIX=tradepulse_

# Brain Controller - Production Optimized
AUTO_START_BRAIN=true
BRAIN_WARMUP_MINUTES=1  # Fast startup for production
BRAIN_AUTO_TRANSITION=true

# Entry Engine - Production Optimized
BYPASS_ENTRY_WARMUP=false
ENTRY_WARMUP_MINUTES=1  # Reduced for production

# Trading Configuration
DEFAULT_SYMBOL=BTCUSDT
TRADING_MODE=day_trading
MAX_POSITIONS=5
RISK_PER_TRADE=0.02

# API Configuration
API_TIMEOUT_SECONDS=30
MAX_REQUESTS_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # JSON for CloudWatch
ENABLE_PERFORMANCE_LOGGING=true

# Security
CORS_ORIGINS=https://app.tradepulseai.co.uk,https://tradepulseai.co.uk
ALLOWED_HOSTS=api.tradepulseai.co.uk

# Health Checks
HEALTH_CHECK_GRACE_PERIOD_SECONDS=30  # Give app time to start
READINESS_CHECK_TIMEOUT_SECONDS=5

# Model Loading
ENABLE_TENSORFLOW_MODELS=true
ENABLE_XGBOOST_MODELS=true
MODEL_LOAD_TIMEOUT_SECONDS=60

# Binance API
BINANCE_TESTNET=false  # Use real Binance for production
BINANCE_API_KEY_SSM_PATH=/tradepulse/binance/api_key
BINANCE_API_SECRET_SSM_PATH=/tradepulse/binance/api_secret

# Monitoring
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9108
ENABLE_CLOUDWATCH_METRICS=true

# Performance
UVICORN_WORKERS=1  # App Runner auto-scales containers
UVICORN_WORKER_CONNECTIONS=1000
UVICORN_KEEPALIVE=5

# Features
ENABLE_CONTINUOUS_LEARNING=true
ENABLE_SESSION_AWARE_TRADING=true
ENABLE_EMERGENCY_CONTROLS=true
ENABLE_RISK_MANAGEMENT=true

# Cache
ENABLE_REDIS_CACHE=false  # Future: add ElastiCache
CACHE_TTL_SECONDS=60
