# TradePulse.AI Backend Environment Configuration
# Copy this file to .env for local development

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=9001
BASE_URL=http://localhost:9001
FRONTEND_URL=http://localhost:4321

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# DynamoDB Configuration
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1

# DynamoDB Table Names
SIGNALS_TABLE=trading_signals
TRADES_TABLE=trading_trades
PORTFOLIOS_TABLE=virtual_portfolios
USERS_TABLE=tradepulse_users
ANALYTICS_TABLE=tradepulse_analytics

# Trading Configuration
DEFAULT_STARTING_BALANCE=10000.0
MAX_POSITION_SIZE_PERCENTAGE=25.0
DEFAULT_STOP_LOSS_PERCENTAGE=2.0
DEFAULT_TAKE_PROFIT_PERCENTAGE=4.0

# External Services
REDIS_URL=redis://localhost:6379
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Market Data
MARKET_DATA_CACHE_TTL=60
MODEL_S3_BUCKET=tradepulse-models

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60