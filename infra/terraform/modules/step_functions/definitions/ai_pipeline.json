{
  "Comment": "TradePulse.AI - AI Trading Signal Generation Pipeline",
  "StartAt": "FeatureEngineering",
  "States": {
    "FeatureEngineering": {
      "Type": "Task",
      "Resource": "${feature_engineering_arn}",
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FeatureEngineeringFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "ParallelModelInference"
    },
    "ParallelModelInference": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "LSTM1mModel",
          "States": {
            "LSTM1mModel": {
              "Type": "Task",
              "Resource": "${ai_inference_arn}",
              "Parameters": {
                "model_type": "lstm_1m",
                "market_data.$": "$.features",
                "timeframe": "1m"
              },
              "TimeoutSeconds": 900,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 3,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "LSTM5mModel",
          "States": {
            "LSTM5mModel": {
              "Type": "Task",
              "Resource": "${ai_inference_arn}",
              "Parameters": {
                "model_type": "lstm_5m",
                "market_data.$": "$.features",
                "timeframe": "5m"
              },
              "TimeoutSeconds": 900,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 3,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "XGBoostEnsemble",
          "States": {
            "XGBoostEnsemble": {
              "Type": "Task",
              "Resource": "${ai_inference_arn}",
              "Parameters": {
                "model_type": "xgb_ensemble",
                "market_data.$": "$.features",
                "timeframe": "multi"
              },
              "TimeoutSeconds": 600,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ModelInferenceFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "EnsembleAggregation"
    },
    "EnsembleAggregation": {
      "Type": "Task",
      "Resource": "${ensemble_aggregator_arn}",
      "Parameters": {
        "model_predictions.$": "$",
        "aggregation_method": "weighted_average",
        "confidence_threshold": 0.7
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "EnsembleAggregationFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "RiskAssessment"
    },
    "RiskAssessment": {
      "Type": "Task",
      "Resource": "${risk_assessment_arn}",
      "Parameters": {
        "prediction.$": "$.aggregated_prediction",
        "current_positions.$": "$.portfolio_state",
        "market_conditions.$": "$.market_data"
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "RiskAssessmentFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "GenerateSignal"
    },
    "GenerateSignal": {
      "Type": "Task",
      "Resource": "${signal_generator_arn}",
      "Parameters": {
        "risk_assessment.$": "$",
        "signal_strength_threshold": 0.8,
        "max_position_size": 0.1
      },
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "SignalGenerationFailed",
          "ResultPath": "$.error"
        }
      ],
      "End": true
    },
    "FeatureEngineeringFailed": {
      "Type": "Fail",
      "Cause": "Feature engineering failed",
      "Error": "FeatureEngineeringError"
    },
    "ModelInferenceFailed": {
      "Type": "Fail",
      "Cause": "Model inference failed",
      "Error": "ModelInferenceError"
    },
    "EnsembleAggregationFailed": {
      "Type": "Fail",
      "Cause": "Ensemble aggregation failed",
      "Error": "EnsembleAggregationError"
    },
    "RiskAssessmentFailed": {
      "Type": "Fail",
      "Cause": "Risk assessment failed",
      "Error": "RiskAssessmentError"
    },
    "SignalGenerationFailed": {
      "Type": "Fail",
      "Cause": "Signal generation failed",
      "Error": "SignalGenerationError"
    }
  }
}
