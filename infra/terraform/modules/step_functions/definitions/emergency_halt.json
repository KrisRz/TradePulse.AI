{
  "Comment": "TradePulse.AI - Emergency Trading Halt Pipeline",
  "StartAt": "CloseAllPositions",
  "States": {
    "CloseAllPositions": {
      "Type": "Task",
      "Resource": "${position_closer_arn}",
      "Parameters": {
        "action": "close_all",
        "reason.$": "$.emergency_reason",
        "force_close": true
      },
      "TimeoutSeconds": 300,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PositionClosingFailed",
          "ResultPath": "$.error"
        }
      ],
      "Next": "SendEmergencyNotification"
    },
    "SendEmergencyNotification": {
      "Type": "Task",
      "Resource": "${notification_arn}",
      "Parameters": {
        "notification_type": "emergency",
        "priority": "critical",
        "message.$": "$.emergency_reason",
        "positions_closed.$": "$.positions_closed",
        "timestamp.$": "$$.State.EnteredTime"
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "NotificationFailed",
          "ResultPath": "$.notification_error"
        }
      ],
      "Next": "LogEmergencyEvent"
    },
    "LogEmergencyEvent": {
      "Type": "Task",
      "Resource": "${audit_logger_arn}",
      "Parameters": {
        "event_type": "emergency_halt",
        "severity": "critical",
        "details": {
          "reason.$": "$.emergency_reason",
          "positions_closed.$": "$.positions_closed",
          "notification_sent.$": "$.notification_sent",
          "execution_arn.$": "$$.Execution.Name",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    },
    "PositionClosingFailed": {
      "Type": "Task",
      "Resource": "${notification_arn}",
      "Parameters": {
        "notification_type": "critical_error",
        "priority": "urgent",
        "message": "CRITICAL: Emergency position closing failed",
        "error_details.$": "$.error",
        "timestamp.$": "$$.State.EnteredTime"
      },
      "TimeoutSeconds": 60,
      "Next": "EmergencyHaltFailed"
    },
    "NotificationFailed": {
      "Type": "Task",
      "Resource": "${audit_logger_arn}",
      "Parameters": {
        "event_type": "notification_failure",
        "severity": "high",
        "details": {
          "original_emergency.$": "$.emergency_reason",
          "notification_error.$": "$.notification_error",
          "positions_closed.$": "$.positions_closed",
          "timestamp.$": "$$.State.EnteredTime"
        }
      },
      "TimeoutSeconds": 60,
      "End": true
    },
    "EmergencyHaltFailed": {
      "Type": "Fail",
      "Cause": "Emergency halt procedure failed - manual intervention required",
      "Error": "EmergencyHaltError"
    }
  }
}
