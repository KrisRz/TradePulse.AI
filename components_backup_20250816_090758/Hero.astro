---
// Hero section component
---

<section class="relative bg-gradient-to-br from-primary-50 to-primary-100 dark:from-dark-900 dark:to-dark-800 py-20 lg:py-32 overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[url('/grid.svg')] bg-repeat"></div>
  </div>
  
  <!-- Floating particles -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-32 h-32 bg-primary-400 rounded-full opacity-20 animate-pulse-slow"></div>
    <div class="absolute top-1/3 right-1/3 w-24 h-24 bg-primary-500 rounded-full opacity-30 animate-bounce-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-20 h-20 bg-primary-600 rounded-full opacity-20 animate-ping-slow"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 rounded-full text-sm font-medium mb-6">
        <span class="w-2 h-2 bg-profit-500 rounded-full mr-2 animate-pulse"></span>
        AI Trading System Live • 68% Win Rate
      </div>
      
      <!-- Main headline -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-6">
        <span class="block">AI-Powered Crypto Trading</span>
        <span class="block text-gradient-animate">That Actually Works</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
        Start with $10,000 virtual portfolio. Prove your profits. Graduate to real money trading.
        <span class="text-primary-600 dark:text-primary-400 font-semibold">No risk, all reward.</span>
      </p>
      
      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 max-w-2xl mx-auto">
        <div class="text-center">
          <div class="text-3xl font-bold text-profit-600 dark:text-profit-400">68%</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">AI Win Rate</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600 dark:text-primary-400">24/7</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Autonomous Trading</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-warning-600 dark:text-warning-400">$10k</div>
          <div class="text-sm text-gray-600 dark:text-gray-400">Virtual Start</div>
        </div>
      </div>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a 
          href="/auth/signup" 
          class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-1 focus-ring"
        >
          Start Virtual Trading
        </a>
        <a 
          href="/demo" 
          class="bg-white dark:bg-dark-800 text-primary-600 dark:text-primary-400 px-8 py-4 rounded-lg font-semibold text-lg border border-primary-200 dark:border-primary-700 hover:bg-primary-50 dark:hover:bg-primary-900 transition-colors focus-ring"
        >
          View Live Demo
        </a>
      </div>
      
      <!-- Social Proof -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-8 text-sm text-gray-600 dark:text-gray-400">
        <div class="flex items-center">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full border-2 border-white dark:border-dark-900 flex items-center justify-center text-white text-xs font-medium">J</div>
            <div class="w-8 h-8 bg-gradient-to-r from-profit-500 to-profit-600 rounded-full border-2 border-white dark:border-dark-900 flex items-center justify-center text-white text-xs font-medium">S</div>
            <div class="w-8 h-8 bg-gradient-to-r from-warning-500 to-warning-600 rounded-full border-2 border-white dark:border-dark-900 flex items-center justify-center text-white text-xs font-medium">M</div>
            <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full border-2 border-white dark:border-dark-900 flex items-center justify-center text-white text-xs font-medium">+</div>
          </div>
          <span class="ml-3">2,847 active traders</span>
        </div>
        <div class="flex items-center">
          <div class="flex text-yellow-400 mr-2">
            {Array.from({length: 5}, (_, i) => (
              <svg key={i} class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span>4.9/5 from 847 reviews</span>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Dashboard Preview -->
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="gradient-border rounded-xl overflow-hidden shadow-2xl">
      <div class="bg-white dark:bg-dark-800 p-1">
        <div class="bg-gray-50 dark:bg-dark-900 rounded-lg p-6">
          <!-- Mock dashboard preview -->
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Virtual Portfolio Dashboard</h3>
            <div class="flex items-center space-x-2">
              <div class="w-2 h-2 bg-profit-500 rounded-full"></div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Live Trading</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <!-- Portfolio Value -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Portfolio Value</div>
              <div class="text-2xl font-bold text-gray-900 dark:text-white">$14,750</div>
              <div class="text-sm text-profit-600 dark:text-profit-400">+47.5% ↗</div>
            </div>
            
            <!-- Today's P&L -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Today's P&L</div>
              <div class="text-2xl font-bold text-profit-600 dark:text-profit-400">+$342</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">+2.38%</div>
            </div>
            
            <!-- AI Confidence -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">AI Confidence</div>
              <div class="text-2xl font-bold text-primary-600 dark:text-primary-400">87%</div>
              <div class="text-sm text-gray-600 dark:text-gray-400">High</div>
            </div>
            
            <!-- Active Trades -->
            <div class="bg-white dark:bg-dark-800 p-4 rounded-lg">
              <div class="text-sm text-gray-600 dark:text-gray-400">Active Trades</div>
              <div class="text-2xl font-bold text-gray-900 dark:text-white">3</div>
              <div class="text-sm text-warning-600 dark:text-warning-400">BTC/USDT</div>
            </div>
          </div>
          
          <!-- Chart placeholder -->
          <div class="mt-6 bg-white dark:bg-dark-800 p-4 rounded-lg">
            <div class="h-32 bg-gradient-to-r from-primary-100 to-profit-100 dark:from-primary-900 dark:to-profit-900 rounded-lg flex items-center justify-center">
              <div class="text-center">
                <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">Live Performance Chart</div>
                <div class="flex items-center justify-center space-x-2">
                  <div class="w-1 h-8 bg-primary-500 rounded animate-pulse"></div>
                  <div class="w-1 h-12 bg-profit-500 rounded animate-pulse" style="animation-delay: 0.2s"></div>
                  <div class="w-1 h-6 bg-primary-400 rounded animate-pulse" style="animation-delay: 0.4s"></div>
                  <div class="w-1 h-16 bg-profit-600 rounded animate-pulse" style="animation-delay: 0.6s"></div>
                  <div class="w-1 h-10 bg-primary-500 rounded animate-pulse" style="animation-delay: 0.8s"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient-animate {
    background: linear-gradient(-45deg, #3b82f6, #1d4ed8, #6366f1, #8b5cf6);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 3s ease infinite;
  }
  
  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  .animate-pulse-slow {
    animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  .animate-bounce-slow {
    animation: bounce 2s infinite;
  }
  
  .animate-ping-slow {
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
</style> 